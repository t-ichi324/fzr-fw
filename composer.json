{
    "name": "fzr/fw",
    "description": "Fzr Framework Core",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "fzr/kit": "dev-main",
        "fzr/kit-extra": "dev-main"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/t-ichi324/fzr-kit.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/t-ichi324/fzr-kit-extra.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Fzr\\": "src/"
        },
        "files": [
            "inc/helpers.php",
            "inc/aliases.php"
        ]
    }
}
