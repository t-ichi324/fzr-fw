; Fzr Configuration (Shared/Fixed Settings)
; Generated: {{GENERATED_AT}}
; ローカル開発では .env ファイルの利用を推奨します。
; include_ini = "append_config.ini"

[app]
name = "{{APP_NAME}}"
key = "{{APP_KEY}}"
timezone = {{TIMEZONE}}
charset = UTF-8
debug = {{DEBUG}}

[path]
app = {{PATH_APP}}
storage = {{PATH_STORAGE}}
db = db
log = {{PATH_STORAGE}}/log
temp = {{PATH_STORAGE}}/temp

; TIP: 実際の値は .env または環境変数で指定してください。
[db]
driver = {{DB_DRIVER}}
auto_migrate = true
{{DB_SQLITE_PATH}}
{{DB_CONFIG_MASKED}}

[storage]
driver = local
public_disk = public
private_disk = private

[storage.public]
driver = local
root = {{PATH_STORAGE}}/public
url = /storage/public

[storage.private]
driver = local
root = {{PATH_STORAGE}}/private

[log]
debug = {{LOG_DEBUG}}
db_sel = {{LOG_DB_SEL}}
db_exe = true
